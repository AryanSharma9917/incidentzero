API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional local overrides (default DB: backend/data/incidentzero.sqlite3)
# DATABASE_PATH=/absolute/path/to/incidentzero.sqlite3
KUBECTL_BIN=kubectl

# Nebius Token Factory (OpenAI-compatible inference)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Tavily Search
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Local Kind is the default. Hosted instances must explicitly use simulation.
APP_ENV=local
EXECUTION_MODE=kubernetes
# Public deployments default to paused when RUNS_ENABLED is omitted.
RUNS_ENABLED=true
# Set a random 24+ character access code before enabling hosted writes.
DEMO_RUN_TOKEN=
DAILY_RUN_LIMIT=20
# Set true when hosting does not provide durable disk storage.
STORAGE_EPHEMERAL=false
